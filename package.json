{
  "name": "pixel-faits",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "@remotion/google-fonts": "4.0.537",
    "@remotion/media": "4.0.537",
    "@remotion/player": "4.0.537",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.537",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/web": "0.0.166",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "test": "vitest run",
    "api": "tsx server/index.ts",
    "ui": "vite --config app/vite.config.ts",
    "batch": "tsx tools/batch.ts",
    "snapshot": "tsx tools/autopilot-snapshot.ts",
    "console": "concurrently -n api,ui -c green,cyan \"npm:api\" \"npm:ui\"",
    "build:web": "vite build --config app/vite.config.ts",
    "deploy": "npm run build:web && firebase deploy --only hosting --project bureau-des-faits",
    "gen:episodes": "tsx tools/gen-data-index.ts"
  },
  "allowScripts": {
    "esbuild": false
  }
}
